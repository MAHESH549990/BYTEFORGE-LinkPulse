
<%- layout("boilerplate/boiler") %>

<style>
    .analytics-page {
        background: #f6f8fc;
        min-height: 85vh;
    }

    .analytics-wrap {
        max-width: 1400px;
        margin: auto;
    }

    .analytics-title {
        color: #18243b;
        font-weight: 750;
    }

    .analytics-card {
        border: 1px solid #e8edf5;
        border-radius: 15px;
        background: #fff;
        height: 100%;
    }

    .stat-label {
        color: #718096;
        font-size: 14px;
    }

    .stat-value {
        color: #18243b;
        font-size: 30px;
        font-weight: 750;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #edf3ff;
        color: #3563d9;
        font-size: 19px;
    }

    .chart-container {
        position: relative;
        height: 300px;
    }

    .chart-heading {
        font-size: 16px;
        font-weight: 700;
        color: #18243b;
    }

    .analytics-table th {
        white-space: nowrap;
        color: #718096;
        font-size: 12px;
        text-transform: uppercase;
    }

    .analytics-table td {
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .short-link {
        overflow-wrap: anywhere;
        color: #3563d9;
    }

    @media (max-width: 576px) {
        .chart-container {
            height: 250px;
        }

        .stat-value {
            font-size: 25px;
        }
    }
</style>

<div class="analytics-page py-4">
    <div class="container-fluid px-3 px-md-4 analytics-wrap">

        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between
                    align-items-center gap-3 mb-4">

            <div>
                <h2 class="analytics-title mb-1">
                    <i class="fa-solid fa-chart-line me-2"></i>
                    Analytics Dashboard
                </h2>

                <p class="text-secondary mb-0">
                    Track your links, clicks, and visitor activity.
                </p>
            </div>

            <form action="/user/analytics" method="GET">
                <select name="days"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="7"
                        <%= days === 7 ? "selected" : "" %>>
                        Last 7 Days
                    </option>

                    <option value="30"
                        <%= days === 30 ? "selected" : "" %>>
                        Last 30 Days
                    </option>

                    <option value="90"
                        <%= days === 90 ? "selected" : "" %>>
                        Last 90 Days
                    </option>
                </select>
            </form>
        </div>

        <!-- Summary Cards -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="analytics-card shadow-sm p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="stat-label">Total Clicks</span>
                        <div class="stat-icon">
                            <i class="fa-solid fa-arrow-pointer"></i>
                        </div>
                    </div>

                    <div class="stat-value">
                        <%= totalClicks.toLocaleString("en-IN") %>
                    </div>

                    <small class="text-secondary">
                        All-time link click counter
                    </small>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="analytics-card shadow-sm p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="stat-label">Period Visits</span>
                        <div class="stat-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>
                    </div>

                    <div class="stat-value">
                        <%= periodClicks.toLocaleString("en-IN") %>
                    </div>

                    <small class="text-secondary">
                        Recorded visits in <%= days %> days
                    </small>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="analytics-card shadow-sm p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="stat-label">My Links</span>
                        <div class="stat-icon">
                            <i class="fa-solid fa-link"></i>
                        </div>
                    </div>

                    <div class="stat-value">
                        <%= links.length.toLocaleString("en-IN") %>
                    </div>

                    <small class="text-secondary">
                        Total links created
                    </small>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="analytics-card shadow-sm p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="stat-label">Links With Clicks</span>
                        <div class="stat-icon">
                            <i class="fa-solid fa-chart-simple"></i>
                        </div>
                    </div>

                    <div class="stat-value">
                        <%= links.filter(link => (link.clicks || 0) > 0).length %>
                    </div>

                    <small class="text-secondary">
                        Links with a non-zero click counter
                    </small>
                </div>
            </div>

        </div>

        <!-- Daily Clicks Chart -->
        <div class="row g-3 mb-4">

            <div class="col-12">
                <div class="analytics-card shadow-sm p-3 p-md-4">
                    <div class="mb-4">
                        <h5 class="chart-heading mb-1">
                            Click Activity
                        </h5>

                        <p class="text-secondary small mb-0">
                            Number of recorded visits per day.
                        </p>
                    </div>

                    <div class="chart-container">
                        <canvas id="clicksChart"></canvas>
                    </div>
                </div>
            </div>

        </div>

        <!-- Browser and Device Charts -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-lg-6">
                <div class="analytics-card shadow-sm p-3 p-md-4">
                    <h5 class="chart-heading mb-1">
                        Browser Breakdown
                    </h5>

                    <p class="text-secondary small mb-3">
                        Browsers identified from visitor data.
                    </p>

                    <div class="chart-container">
                        <canvas id="browserChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="analytics-card shadow-sm p-3 p-md-4">
                    <h5 class="chart-heading mb-1">
                        Device Breakdown
                    </h5>

                    <p class="text-secondary small mb-3">
                        Estimated device categories.
                    </p>

                    <div class="chart-container">
                        <canvas id="deviceChart"></canvas>
                    </div>
                </div>
            </div>

        </div>

        <!-- Referrer Chart -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-lg-6">
                <div class="analytics-card shadow-sm p-3 p-md-4">
                    <h5 class="chart-heading mb-1">
                        Traffic Sources
                    </h5>

                    <p class="text-secondary small mb-3">
                        Where recorded visitors came from.
                    </p>

                    <div class="chart-container">
                        <canvas id="referrerChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Top Links -->
            <div class="col-12 col-lg-6">
                <div class="analytics-card shadow-sm p-3 p-md-4">
                    <h5 class="chart-heading mb-1">
                        Top Performing Links
                    </h5>

                    <p class="text-secondary small mb-3">
                        Your five links with the highest click counters.
                    </p>

                    <% if (topLinks.length === 0) { %>

                        <div class="text-center py-5">
                            <i class="fa-solid fa-link fs-2
                                      text-secondary mb-3"></i>

                            <p class="text-secondary mb-0">
                                You haven't created any links yet.
                            </p>
                        </div>

                    <% } else { %>

                        <% topLinks.forEach((link, index) => { %>
                            <div class="d-flex align-items-center
                                        gap-3 py-3
                                        <%= index !== topLinks.length - 1
                                            ? 'border-bottom' : '' %>">

                                <div class="stat-icon flex-shrink-0">
                                    <%= index + 1 %>
                                </div>

                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold short-link">
                                        <%= link.shortUrl %>
                                    </div>

                                    <small class="text-secondary">
                                        <%= link.originalUrl %>
                                    </small>
                                </div>

                                <div class="text-end">
                                    <div class="fw-bold">
                                        <%= link.clicks || 0 %>
                                    </div>

                                    <small class="text-secondary">
                                        clicks
                                    </small>
                                </div>
                            </div>
                        <% }); %>

                    <% } %>
                </div>
            </div>

        </div>

        <!-- Recent Visits -->
        <div class="analytics-card shadow-sm p-3 p-md-4 mb-4">
            <div class="mb-3">
                <h5 class="chart-heading mb-1">
                    Recent Visitor Activity
                </h5>

                <p class="text-secondary small mb-0">
                    Latest recorded visits within the selected period.
                </p>
            </div>

            <% if (recentVisits.length === 0) { %>

                <div class="text-center py-5">
                    <i class="fa-solid fa-chart-line fs-2
                              text-secondary mb-3"></i>

                    <h6 class="fw-bold">No visits recorded yet</h6>

                    <p class="text-secondary mb-3">
                        Share your short links to start seeing analytics.
                    </p>

                    <a href="/user/links" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-link me-1"></i>
                        My Links
                    </a>
                </div>

            <% } else { %>

                <div class="table-responsive">
                    <table class="table table-hover analytics-table
                                  align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Visited At</th>
                                <th>Short Link</th>
                                <th>Browser</th>
                                <th>Referrer</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% recentVisits.forEach(visit => {
                                const ua = visit.userAgent || "";
                                let browser = "Other";

                                if (/Edg\//i.test(ua)) {
                                    browser = "Edge";
                                } else if (/OPR\//i.test(ua)) {
                                    browser = "Opera";
                                } else if (/Firefox\//i.test(ua)) {
                                    browser = "Firefox";
                                } else if (/Chrome\//i.test(ua)) {
                                    browser = "Chrome";
                                } else if (/Safari\//i.test(ua)) {
                                    browser = "Safari";
                                }

                                const visitLinkId = String(visit.link);
                                const matchedLink = links.find(
                                    item => String(item._id) === visitLinkId
                                );
                            %>

                                <tr>
                                    <td class="text-nowrap">
                                        <%= new Date(visit.visitedAt)
                                            .toLocaleString("en-IN", {
                                                day: "2-digit",
                                                month: "short",
                                                year: "numeric",
                                                hour: "2-digit",
                                                minute: "2-digit"
                                            }) %>
                                    </td>

                                    <td class="short-link">
                                        <%= matchedLink
                                            ? matchedLink.shortUrl
                                            : "Link unavailable" %>
                                    </td>

                                    <td><%= browser %></td>

                                    <td>
                                        <div style="max-width: 220px;
                                                    overflow-wrap: anywhere;">
                                            <%= visit.referrer || "Direct" %>
                                        </div>
                                    </td>
                                </tr>

                            <% }); %>
                        </tbody>

                    </table>
                </div>

            <% } %>
        </div>

        <p class="small text-secondary mb-0">
            <i class="fa-solid fa-circle-info me-1"></i>
            Charts use saved Visit records. Browser and device categories
            are estimates, not guaranteed identification.
        </p>

    </div>
</div>
<div id="analyticsData"
     data-daily-labels='<%= JSON.stringify(dailyLabels || []) %>'
     data-daily-clicks='<%= JSON.stringify(dailyClicks || []) %>'
     data-browser-labels='<%= JSON.stringify(browserLabels || []) %>'
     data-browser-values='<%= JSON.stringify(browserValues || []) %>'
     data-device-labels='<%= JSON.stringify(deviceLabels || []) %>'
     data-device-values='<%= JSON.stringify(deviceValues || []) %>'
     data-referrer-labels='<%= JSON.stringify(referrerLabels || []) %>'
     data-referrer-values='<%= JSON.stringify(referrerValues || []) %>'>
</div>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Backend data passed from Express
    const dataElement = document.getElementById("analyticsData");

    const dailyLabels = JSON.parse(dataElement.dataset.dailyLabels);
    const dailyClicks = JSON.parse(dataElement.dataset.dailyClicks);

    const browserLabels = JSON.parse(dataElement.dataset.browserLabels);
    const browserValues = JSON.parse(dataElement.dataset.browserValues);

    const deviceLabels = JSON.parse(dataElement.dataset.deviceLabels);
    const deviceValues = JSON.parse(dataElement.dataset.deviceValues);

    const referrerLabels = JSON.parse(dataElement.dataset.referrerLabels);
    const referrerValues = JSON.parse(dataElement.dataset.referrerValues);
    // Convert YYYY-MM-DD to a readable date
    const formattedDates = dailyLabels.map(value => {
        const [year, month, day] = value.split("-").map(Number);

        return new Date(year, month - 1, day).toLocaleDateString(
            "en-IN",
            { day: "2-digit", month: "short" }
        );
    });

    // Daily clicks: line chart
    new Chart(document.getElementById("clicksChart"), {
        type: "line",

        data: {
            labels: formattedDates,

            datasets: [{
                label: "Recorded Visits",
                data: dailyClicks,
                borderColor: "#3563d9",
                backgroundColor: "rgba(53, 99, 217, 0.12)",
                fill: true,
                tension: 0.35,
                borderWidth: 3,
                pointRadius: 3,
                pointHoverRadius: 6
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            interaction: {
                intersect: false,
                mode: "index"
            },

            plugins: {
                legend: {
                    display: false
                }
            },

            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                },

                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });

    // Browser breakdown: doughnut chart
    new Chart(document.getElementById("browserChart"), {
        type: "doughnut",

        data: {
            labels: browserLabels,

            datasets: [{
                data: browserValues,
                backgroundColor: [
                    "#3563d9",
                    "#22a06b",
                    "#f59e0b",
                    "#e45b65",
                    "#8b5cf6",
                    "#64748b"
                ],
                borderWidth: 2,
                borderColor: "#ffffff"
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    position: "bottom"
                }
            }
        }
    });

    // Device breakdown: doughnut chart
    new Chart(document.getElementById("deviceChart"), {
        type: "doughnut",

        data: {
            labels: deviceLabels,

            datasets: [{
                data: deviceValues,
                backgroundColor: [
                    "#3563d9",
                    "#22a06b",
                    "#f59e0b"
                ],
                borderWidth: 2,
                borderColor: "#ffffff"
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    position: "bottom"
                }
            }
        }
    });

    // Traffic sources: horizontal bar chart
    new Chart(document.getElementById("referrerChart"), {
        type: "bar",

        data: {
            labels: referrerLabels,

            datasets: [{
                label: "Visits",
                data: referrerValues,
                backgroundColor: "#3563d9",
                borderRadius: 6,
                maxBarThickness: 35
            }]
        },

        options: {
            indexAxis: "y",
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    display: false
                }
            },

            scales: {
                x: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                },

                y: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });
</script>
