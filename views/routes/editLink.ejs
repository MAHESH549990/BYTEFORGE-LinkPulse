
<%- layout("boilerplate/boiler") %>

<div class="container py-5" style="max-width: 700px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            <div class="mb-4">
                <h2 class="fw-bold mb-2">Edit Short Link</h2>
                <p class="text-secondary mb-0">
                    Update the destination URL or customize your short link.
                </p>
            </div>

            <form action="/user/links/<%= link._id %>?_method=PUT" method="POST">

                <div class="mb-4">
                    <label for="originalUrl" class="form-label fw-semibold">
                        Original URL
                    </label>
                    <input
                        type="url"
                        id="originalUrl"
                        name="originalUrl"
                        class="form-control"
                        value="<%= link.originalUrl %>"
                        placeholder="https://example.com"
                        required
                    >
                    <div class="form-text">
                        Enter the website where visitors should be redirected.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="shortUrl" class="form-label fw-semibold">
                        Short Link Code
                    </label>
                    <input
                        type="text"
                        id="shortUrl"
                        name="shortUrl"
                        class="form-control"
                        value="<%= link.shortUrl %>"
                        pattern="[a-zA-Z0-9_-]+"
                        minlength="3"
                        maxlength="50"
                        title="Use letters, numbers, hyphens, or underscores."
                        required
                    >
                    <div class="form-text">
                        Use letters, numbers, hyphens, or underscores.
                        Changing this code changes the short link people use.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Save Changes
                    </button>

                    <a href="/user/links" class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>
