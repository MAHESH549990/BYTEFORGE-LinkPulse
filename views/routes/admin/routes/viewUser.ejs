
<%- layout("routes/admin/boiler/adminboiler") %>

<div class="container-fluid px-3 px-md-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Users Management</h2>
            <p class="text-muted mb-0">Manage users, shortened links and campaigns.</p>
        </div>

        <span class="badge text-bg-dark px-3 py-2">
            Total Users: <%= users.length %>
        </span>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3">
                        <i class="fa-solid fa-users fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-1">Total Users</p>
                        <h4 class="fw-bold mb-0"><%= users.length %></h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success-subtle text-success p-3">
                        <i class="fa-solid fa-link fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-1">Total Links</p>
                        <h4 class="fw-bold mb-0"><%= users.reduce((sum, user) => sum + (user.links ? user.links.length : 0), 0) %></h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning-subtle text-warning p-3">
                        <i class="fa-solid fa-bullhorn fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-1">Campaigns</p>
                        <h4 class="fw-bold mb-0">
                            <%= users.reduce((sum, user) => sum + (user.links ? user.links.filter(link => link.campaignName || link.campaign).length : 0), 0) %>
                        </h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info-subtle text-info p-3">
                        <i class="fa-solid fa-arrow-pointer fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-1">Total Clicks</p>
                        <h4 class="fw-bold mb-0"><%= users.reduce((sum, user) => sum + (user.links ? user.links.reduce((linkSum, link) => linkSum + (Number(link.clicks) || 0), 0) : 0), 0).toLocaleString("en-IN") %></h4>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="fa-solid fa-search text-muted"></i>
                </span>
                <input
                    type="text"
                    id="userSearch"
                    class="form-control"
                    placeholder="Search by username or email..."
                >
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Registered Users</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="usersTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Joined</th>
                        <th>Total Links</th>
                        <th>Total Clicks</th>
                        <th>Campaigns</th>
                        <th>Details</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (users.length === 0) { %>
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                No users found.
                            </td>
                        </tr>
                    <% } else { %>
                        <% users.forEach((user, index) => { %>
                            <tr class="user-row">
                                <td class="ps-3"><%= index + 1 %></td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold"
                                             style="width:42px;height:42px;flex-shrink:0;">
                                            <%= (user.username || user.email || "U").charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <div class="fw-semibold user-name">
                                                <%= user.username || "Unnamed User" %>
                                            </div>
                                            <div class="small text-muted user-email">
                                                <%= user.email || "No email" %>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge <%= user.role === 'admin' ? 'text-bg-dark' : 'text-bg-primary' %>">
                                        <%= user.role || "user" %>
                                    </span>
                                </td>

                                <td class="text-muted small">
                                    <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-IN") : "—" %>
                                </td>

                                <td>
                                    <span class="badge text-bg-light border">
                                        <%= user.links ? user.links.length : 0 %>
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    <%= (user.links || []).reduce((sum, link) => sum + (Number(link.clicks) || 0), 0).toLocaleString("en-IN") %>
                                </td>

                                <td>
                                    <%= (user.links || []).filter(link => link.campaignName || link.campaign).length %>
                                </td>

                                <td>
                                    <button
                                        class="btn btn-sm btn-outline-primary"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#userDetails<%= index %>"
                                        aria-expanded="false">
                                        <i class="fa-solid fa-eye me-1"></i> View
                                    </button>
                                </td>
                            </tr>

                            <!-- Expanded User Details -->
                            <tr class="user-details-row">
                                <td colspan="8" class="p-0 border-0">
                                    <div class="collapse" id="userDetails<%= index %>">
                                        <div class="p-3 p-md-4 bg-light border-bottom">

                                            <h6 class="fw-bold mb-3">
                                                <i class="fa-solid fa-user me-2"></i>
                                                <%= user.username || user.email || "User" %> — Link Details
                                            </h6>

                                            <% if (!user.links || user.links.length === 0) { %>
                                                <div class="alert alert-light border mb-0">
                                                    This user has not created any links yet.
                                                </div>
                                            <% } else { %>

                                                <div class="table-responsive bg-white rounded border">
                                                    <table class="table table-sm align-middle mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th class="ps-3">#</th>
                                                                <th>Original URL</th>
                                                                <th>Short Link</th>
                                                                <th>Campaign</th>
                                                                <th>Clicks</th>
                                                                <th>Created</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            <% user.links.forEach((link, linkIndex) => { %>
                                                                <tr>
                                                                    <td class="ps-3"><%= linkIndex + 1 %></td>

                                                                    <td style="min-width:180px;max-width:300px;overflow-wrap:anywhere;">
                                                                        <a href="<%= link.originalUrl %>"
                                                                           target="_blank"
                                                                           rel="noopener noreferrer"
                                                                           class="text-decoration-none">
                                                                            <%= link.originalUrl %>
                                                                        </a>
                                                                    </td>

                                                                    <td style="min-width:130px;">
                                                                        <%= link.shortUrl || "—" %>
                                                                    </td>

                                                                    <td>
                                                                        <% if (link.campaignName || link.campaign) { %>
                                                                            <span class="badge text-bg-warning">
                                                                                <%= typeof link.campaign === "object" ? (link.campaign.name || link.campaignName || "Campaign") : (link.campaignName || link.campaign) %>
                                                                            </span>
                                                                        <% } else { %>
                                                                            <span class="text-muted">No campaign</span>
                                                                        <% } %>
                                                                    </td>

                                                                    <td>
                                                                        <span class="badge text-bg-success">
                                                                            <%= Number(link.clicks) || 0 %>
                                                                        </span>
                                                                    </td>

                                                                    <td class="text-muted small">
                                                                        <%= link.createdAt ? new Date(link.createdAt).toLocaleDateString("en-IN") : "—" %>
                                                                    </td>
                                                                </tr>
                                                            <% }) %>
                                                        </tbody>
                                                    </table>
                                                </div>

                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("userSearch");
        const rows = document.querySelectorAll("#usersTable tbody tr.user-row");

        searchInput.addEventListener("input", function () {
            const query = this.value.toLowerCase().trim();

            rows.forEach(function (row) {
                const name = row.querySelector(".user-name")?.textContent.toLowerCase() || "";
                const email = row.querySelector(".user-email")?.textContent.toLowerCase() || "";
                const visible = name.includes(query) || email.includes(query);

                row.style.display = visible ? "" : "none";

                // Also hide the expandable details row when its user doesn't match.
                const detailsRow = row.nextElementSibling;
                if (detailsRow && detailsRow.classList.contains("user-details-row")) {
                    detailsRow.style.display = visible ? "" : "none";
                }
            });
        });
    });
</script>
