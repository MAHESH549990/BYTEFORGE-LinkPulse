
<%- layout("boilerplate/boiler") %>

<style>
    .url-workspace {
        max-width: 1080px;
        margin: 0 auto;
    }

    .url-hero {
        background: #111827;
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 30px;
        position: relative;
        overflow: hidden;
    }

    .url-hero::after {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        right: -50px;
        top: -85px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50%;
        box-shadow: 0 0 0 25px rgba(255,255,255,.025),
                    0 0 0 50px rgba(255,255,255,.025);
    }

    .url-hero-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #315efb;
        color: white;
        font-size: 21px;
        margin-bottom: 20px;
    }

    .url-hero h2 {
        font-weight: 750;
        letter-spacing: -0.7px;
    }

    .url-hero p {
        color: #b8c2d6;
        max-width: 500px;
        margin-bottom: 0;
        line-height: 1.7;
    }

    .url-main-card {
        background: #fff;
        border: 1px solid #e5e9f2;
        border-top: 0;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 18px 55px rgba(20, 35, 70, .07);
        overflow: hidden;
    }

    .url-form-section {
        padding: 32px;
    }

    .url-field-label {
        font-size: 14px;
        font-weight: 650;
        color: #202b40;
        margin-bottom: 9px;
    }

    .url-input {
        min-height: 49px;
        border: 1px solid #dce2ed;
        border-radius: 9px !important;
        padding: 12px 14px;
        font-size: 14px;
        transition: border-color .2s, box-shadow .2s;
    }

    .url-input:focus {
        border-color: #315efb;
        box-shadow: 0 0 0 3px rgba(49, 94, 251, .10);
    }

    .url-input-group .input-group-text {
        background: #f5f7fb;
        border-color: #dce2ed;
        color: #315efb;
        font-weight: 700;
        border-radius: 9px 0 0 9px;
    }

    .url-input-group .url-input {
        border-radius: 0 9px 9px 0 !important;
    }

    .url-help {
        font-size: 12px;
        color: #7b8496;
        margin-top: 8px;
    }

    .url-preview-panel {
        background: #f5f7ff;
        border: 1px solid #dce5ff;
        border-radius: 12px;
        padding: 19px;
        margin-top: 28px;
    }

    .url-preview-heading {
        font-size: 12px;
        font-weight: 700;
        color: #59657d;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .url-preview-value {
        color: #234de2;
        font-weight: 650;
        font-size: 15px;
        overflow-wrap: anywhere;
    }

    .url-create-btn {
        min-height: 49px;
        border: 0;
        border-radius: 9px;
        background: #315efb;
        font-weight: 650;
        transition: background .2s, transform .2s;
    }

    .url-create-btn:hover {
        background: #2448d8;
        transform: translateY(-1px);
    }

    .url-side-panel {
        height: 100%;
        background: #f9fafc;
        border-left: 1px solid #edf0f5;
        padding: 32px 25px;
    }

    .url-step {
        display: flex;
        gap: 13px;
        margin-bottom: 26px;
    }

    .url-step-number {
        width: 31px;
        height: 31px;
        min-width: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #e9eeff;
        color: #315efb;
        font-size: 13px;
        font-weight: 750;
    }

    .url-step h6 {
        font-size: 14px;
        font-weight: 700;
        margin: 3px 0 6px;
    }

    .url-step p {
        font-size: 12px;
        color: #7b8496;
        line-height: 1.6;
        margin-bottom: 0;
    }

    .url-example {
        border-top: 1px solid #e5e9f0;
        padding-top: 22px;
        margin-top: 8px;
    }

    .url-example-label {
        font-size: 11px;
        color: #858da0;
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-bottom: 5px;
    }

    .url-example-value {
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    @media (max-width: 767px) {
        .url-hero {
            padding: 25px 22px;
        }

        .url-form-section {
            padding: 24px 20px;
        }

        .url-side-panel {
            border-left: 0;
            border-top: 1px solid #edf0f5;
            padding: 25px 20px;
        }
    }
</style>

<div class="container py-5">
    <div class="url-workspace">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center
                    flex-wrap gap-3 mb-4">
            <div>
                <div class="text-primary small fw-bold mb-2">
                    <i class="fa-solid fa-layer-group me-1"></i>
                    LINKPULSE / URL TOOLS
                </div>
                <h3 class="fw-bold mb-1">Create your link</h3>
                <p class="text-secondary mb-0 small">
                    Make every link easier to share.
                </p>
            </div>

            <span class="badge rounded-pill text-bg-light border px-3 py-2">
                <i class="fa-solid fa-bolt text-primary me-1"></i>
                Quick creation
            </span>
        </div>

        <!-- Main Workspace -->
        <div class="url-hero">
            <div class="url-hero-icon">
                <i class="fa-solid fa-link"></i>
            </div>

            <h2 class="mb-2">Long link. Short identity.</h2>
            <p>
                Add your destination, choose a custom name, and create a
                short link that is easy to remember.
            </p>
        </div>

        <div class="url-main-card">
            <div class="row g-0">

                <!-- Form -->
                <div class="col-12 col-md-7">
                    <div class="url-form-section">

                        <div class="mb-4">
                            <h5 class="fw-bold mb-1">Link details</h5>
                            <p class="text-secondary small mb-0">
                                Enter the details for your new short URL.
                            </p>
                        </div>

                        <form action="/user/shorten/link" method="POST">

                            <div class="mb-4">
                                <label for="originalUrl"
                                       class="form-label url-field-label">
                                    <i class="fa-solid fa-arrow-up-right-from-square
                                              text-primary me-2"></i>
                                    Destination URL
                                </label>

                                <input
                                    type="url"
                                    class="form-control url-input"
                                    id="originalUrl"
                                    name="originalUrl"
                                    placeholder="https://example.com/page"
                                    required
                                >

                                <div class="url-help">
                                    Paste the complete web address you want to share.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="customName"
                                       class="form-label url-field-label">
                                    <i class="fa-solid fa-pen-to-square
                                              text-primary me-2"></i>
                                    Custom alias
                                </label>

                                <div class="input-group url-input-group">
                                    <span class="input-group-text">/</span>

                                    <input
                                        type="text"
                                        class="form-control url-input"
                                        id="customName"
                                        name="customName"
                                        placeholder="my-favorite-song"
                                        pattern="[A-Za-z0-9_-]+"
                                        minlength="3"
                                        maxlength="40"
                                        title="Use letters, numbers, hyphens, or underscores."
                                        required
                                    >
                                </div>

                                <div class="url-help">
                                    Choose a unique name. If it's already taken,
                                    you'll need another one.
                                </div>
                            </div>

                            <!-- Live Preview -->
                            <div class="url-preview-panel">
                                <div class="d-flex justify-content-between
                                            align-items-center mb-3">
                                    <span class="url-preview-heading">
                                        Your short link
                                    </span>
                                    <i class="fa-regular fa-eye text-primary"></i>
                                </div>

                                <div class="url-preview-value"
                                     id="shortUrlPreview">
                                    https://linkpulse-es6s.onrender.com/user/s/your-custom-name
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary url-create-btn
                                           text-white w-100 mt-4">
                                Create short link
                                <i class="fa-solid fa-arrow-right ms-2"></i>
                            </button>

                            <p class="text-secondary text-center mt-3 mb-0"
                               style="font-size: 11px;">
                                <i class="fa-solid fa-shield-halved me-1"></i>
                                Make sure your destination URL is correct.
                            </p>
                        </form>
                    </div>
                </div>

                <!-- Side Information -->
                <div class="col-12 col-md-5">
                    <div class="url-side-panel">

                        <h6 class="fw-bold mb-4">How it works</h6>

                        <div class="url-step">
                            <div class="url-step-number">01</div>
                            <div>
                                <h6>Paste your URL</h6>
                                <p>
                                    Add the long web address you want
                                    people to visit.
                                </p>
                            </div>
                        </div>

                        <div class="url-step">
                            <div class="url-step-number">02</div>
                            <div>
                                <h6>Choose your alias</h6>
                                <p>
                                    Create a short, memorable name for
                                    your link.
                                </p>
                            </div>
                        </div>

                        <div class="url-step">
                            <div class="url-step-number">03</div>
                            <div>
                                <h6>Share your link</h6>
                                <p>
                                    Your short URL points visitors to
                                    your original destination.
                                </p>
                            </div>
                        </div>

                        <div class="url-example">
                            <div class="url-example-label">
                                Original URL
                            </div>
                            <div class="url-example-value text-secondary mb-3">
                                https://www.youtube.com/watch?v=abc123
                            </div>

                            <div class="url-example-label">
                                Custom alias
                            </div>
                            <div class="url-example-value fw-semibold mb-3">
                                my-favorite-song
                            </div>

                            <div class="url-example-label">
                                Result
                            </div>
                            <div class="url-example-value text-primary fw-semibold">
                                https://linkpulse-es6s.onrender.com/user/s/my-favorite-song
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<script>
    const customNameInput = document.getElementById("customName");
    const shortUrlPreview = document.getElementById("shortUrlPreview");

    customNameInput.addEventListener("input", function () {
        const value = this.value.trim();

        shortUrlPreview.textContent =
            `localhost:8080/${value || "your-custom-name"}`;
    });
</script>
