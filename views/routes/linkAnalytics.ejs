
<%- layout("boilerplate/boiler") %>

<style>
    .analytics-page {
        min-height: 80vh;
        background: #f6f8fc;
    }

    .analytics-content {
        max-width: 1250px;
        margin: 0 auto;
    }

    .analytics-heading {
        color: #17233d;
    }

    .analytics-card {
        border: 1px solid #e8edf5;
        border-radius: 14px;
        overflow: hidden;
    }

    .analytics-card .card-body {
        padding: 24px;
    }

    .stat-label {
        color: #647084;
        font-size: 14px;
    }

    .stat-number {
        color: #17233d;
        font-size: 30px;
        font-weight: 750;
    }

    .analytics-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: #edf3ff;
        color: #315edb;
        font-size: 19px;
    }

    .visitor-table th {
        color: #647084;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .visitor-table td {
        padding-top: 16px;
        padding-bottom: 16px;
    }

    .empty-icon {
        width: 76px;
        height: 76px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 22px;
        background: #edf3ff;
        color: #315edb;
        font-size: 30px;
    }

    .visitor-referrer {
        max-width: 260px;
        overflow-wrap: anywhere;
    }

    @media (max-width: 576px) {
        .analytics-content {
            padding-left: 14px !important;
            padding-right: 14px !important;
        }

        .analytics-card .card-body {
            padding: 17px;
        }
    }
</style>

<div class="analytics-page">
    <div class="analytics-content container-fluid py-4 px-4">

        <!-- Page Header -->
        <div class="d-flex flex-wrap justify-content-between
                    align-items-center gap-3 mb-4">

            <div>
                <h2 class="fw-bold analytics-heading mb-1">
                    <i class="fa-solid fa-chart-line me-2"></i>
                    Link Analytics
                </h2>

                <p class="text-secondary mb-2">
                    Visitor activity for
                    <strong><%= link.shortUrl %></strong>
                </p>

                <a href="/user/s/<%= encodeURIComponent(link.shortUrl) %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-decoration-none small">
                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
                    Open short link
                </a>
            </div>

            <a href="/user/links"
               class="btn btn-outline-secondary px-3">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back to My Links
            </a>
        </div>

        <!-- Statistics -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-sm-6">
                <div class="card analytics-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between
                                    align-items-center mb-3">
                            <span class="stat-label">Total Clicks</span>

                            <div class="analytics-icon">
                                <i class="fa-solid fa-arrow-pointer"></i>
                            </div>
                        </div>

                        <div class="stat-number">
                            <%= link.clicks || 0 %>
                        </div>

                        <small class="text-secondary">
                            Total clicks recorded for this link
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6">
                <div class="card analytics-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between
                                    align-items-center mb-3">
                            <span class="stat-label">Recorded Visits</span>

                            <div class="analytics-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>
                        </div>

                        <div class="stat-number">
                            <%= visits.length %>
                        </div>

                        <small class="text-secondary">
                            Individual visit records saved
                        </small>
                    </div>
                </div>
            </div>

        </div>

        <!-- Visitor History -->
        <div class="card analytics-card shadow-sm">
            <div class="card-body">

                <div class="d-flex flex-wrap justify-content-between
                            align-items-center gap-2 mb-4">
                    <div>
                        <h5 class="fw-bold mb-1">Visitor History</h5>
                        <p class="text-secondary small mb-0">
                            See when people visited your short link.
                        </p>
                    </div>

                    <span class="badge rounded-pill bg-light
                                 text-secondary border px-3 py-2">
                        <%= visits.length %> visits
                    </span>
                </div>

                <% if (visits.length === 0) { %>

                    <!-- Empty State -->
                    <div class="text-center py-5 px-3">

                        <div class="empty-icon mb-3">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>

                        <h5 class="fw-bold mb-2">
                            No visitors yet
                        </h5>

                        <p class="text-secondary mx-auto mb-4"
                           style="max-width: 440px;">
                            Your short link is ready to go! Once someone
                            visits it, their visit time, browser, device,
                            and referral source will appear here.
                            Share your link to start tracking activity.
                        </p>

                        <button
                            type="button"
                            class="btn btn-primary px-4"
                            onclick="copyAnalyticsLink(this)"
                            data-link="<%= '/user/s/' + link.shortUrl %>">

                            <i class="fa-regular fa-copy me-2"></i>
                            Copy Short Link
                        </button>

                        <div class="mt-3">
                            <a href="/user/links"
                               class="text-decoration-none small">
                                <i class="fa-solid fa-arrow-left me-1"></i>
                                Back to My Links
                            </a>
                        </div>

                    </div>

                <% } else { %>

                    <div class="table-responsive">
                        <table class="table table-hover
                                      visitor-table align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Visited At</th>
                                    <th>Browser</th>
                                    <th>Device</th>
                                    <th>Referrer</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% visits.forEach((visit, index) => {
                                    const ua = visit.userAgent || "";

                                    let browser = "Other";
                                    let device = "Desktop";

                                    if (/Edg\//i.test(ua)) {
                                        browser = "Edge";
                                    } else if (/OPR\//i.test(ua)) {
                                        browser = "Opera";
                                    } else if (/Firefox\//i.test(ua)) {
                                        browser = "Firefox";
                                    } else if (/Chrome\//i.test(ua)) {
                                        browser = "Chrome";
                                    } else if (/Safari\//i.test(ua)) {
                                        browser = "Safari";
                                    }

                                    if (/iPad|Tablet/i.test(ua)) {
                                        device = "Tablet";
                                    } else if (/iPhone|Android|Mobile/i.test(ua)) {
                                        device = "Mobile";
                                    }
                                %>

                                    <tr>
                                        <td class="text-secondary">
                                            <%= index + 1 %>
                                        </td>

                                        <td class="text-nowrap">
                                            <div class="fw-semibold">
                                                <%= new Date(visit.visitedAt).toLocaleDateString("en-IN", {
                                                    timeZone: "Asia/Kolkata",
                                                    day: "2-digit",
                                                    month: "short",
                                                    year: "numeric"
                                                }) %>
                                            </div>

                                            <small class="text-secondary">
                                                <%= new Date(visit.visitedAt).toLocaleTimeString("en-IN", {
                                                    timeZone: "Asia/Kolkata",
                                                    hour: "2-digit",
                                                    minute: "2-digit",
                                                    second: "2-digit",
                                                    hour12: true
                                                }) %>
                                            </small>
                                        </td>
                                        <td>
                                            <i class="fa-solid fa-globe
                                                      text-secondary me-1"></i>
                                            <%= browser %>
                                        </td>

                                        <td>
                                            <% if (device === "Mobile") { %>
                                                <i class="fa-solid fa-mobile-screen
                                                          text-secondary me-1"></i>
                                            <% } else if (device === "Tablet") { %>
                                                <i class="fa-solid fa-tablet-screen-button
                                                          text-secondary me-1"></i>
                                            <% } else { %>
                                                <i class="fa-solid fa-desktop
                                                          text-secondary me-1"></i>
                                            <% } %>

                                            <%= device %>
                                        </td>

                                        <td>
                                            <div class="visitor-referrer">
                                                <%= visit.referrer || "Direct" %>
                                            </div>
                                        </td>
                                    </tr>

                                <% }); %>
                            </tbody>

                        </table>
                    </div>

                <% } %>

            </div>
        </div>

        <p class="text-secondary small mt-3 mb-0">
            <i class="fa-solid fa-circle-info me-1"></i>
            Browser and device information are estimated from the visitor's
            browser data. Referrer information may be unavailable.
        </p>

    </div>
</div>

<script>
    async function copyAnalyticsLink(button) {
        const url = window.location.origin + button.dataset.link;
        const originalHTML = button.innerHTML;

        try {
            await navigator.clipboard.writeText(url);

            button.innerHTML =
                '<i class="fa-solid fa-check me-2"></i>Link Copied!';

            button.classList.remove("btn-primary");
            button.classList.add("btn-success");

            setTimeout(() => {
                button.innerHTML = originalHTML;
                button.classList.remove("btn-success");
                button.classList.add("btn-primary");
            }, 2000);

        } catch (error) {
            window.prompt("Copy your short link:", url);
        }
    }
</script>
