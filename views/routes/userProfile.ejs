
<%- layout("boilerplate/boiler") %>

<div class="container py-5">

    <!-- Profile Heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Profile</h2>
            <p class="text-secondary mb-0">
                Manage and view your account information.
            </p>
        </div>

        <span class="badge rounded-pill text-bg-success px-3 py-2">
            <i class="fa-solid fa-circle-check me-1"></i>
            Account Active
        </span>
    </div>

    <div class="row g-4">

        <!-- Profile Summary -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body text-center p-4">

                    <div class="rounded-circle bg-primary-subtle text-primary
                                d-flex justify-content-center align-items-center
                                mx-auto mb-3 fw-bold border border-3 border-white shadow-sm"
                         style="width: 105px; height: 105px; font-size: 40px;">
                        <%= (user.username || user.email || "U").charAt(0).toUpperCase() %>
                    </div>

                    <h4 class="fw-bold mb-1">
                        <%= user.username || "User" %>
                    </h4>

                    <p class="text-secondary small text-break mb-3">
                        <%= user.email || "Email not available" %>
                    </p>

                    <hr>

                    <div class="d-flex align-items-center justify-content-center gap-2 text-success mb-3">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span class="small fw-semibold">Account Protected</span>
                    </div>

                    <a href="/user/dashboard"
                       class="btn btn-primary w-100 rounded-3 py-2">
                        <i class="fa-solid fa-house me-2"></i>
                        Go to Dashboard
                    </a>

                </div>
            </div>
        </div>

        <!-- Account Details -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold mb-1">
                        <i class="fa-solid fa-id-card text-primary me-2"></i>
                        Personal Information
                    </h5>
                    <p class="text-secondary small mb-0">
                        Your registered account details.
                    </p>
                </div>

                <div class="card-body p-4">

                    <!-- Username -->
                    <div class="d-flex align-items-start gap-3 p-3 mb-3 rounded-3 bg-light">
                        <div class="rounded-3 bg-white shadow-sm p-3 text-primary">
                            <i class="fa-solid fa-user fa-lg"></i>
                        </div>

                        <div class="flex-grow-1">
                            <p class="text-secondary small mb-1">Username</p>
                            <h6 class="fw-semibold mb-0 text-break">
                                <%= user.username || "Not available" %>
                            </h6>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="d-flex align-items-start gap-3 p-3 mb-3 rounded-3 bg-light">
                        <div class="rounded-3 bg-white shadow-sm p-3 text-primary">
                            <i class="fa-solid fa-envelope fa-lg"></i>
                        </div>

                        <div class="flex-grow-1">
                            <p class="text-secondary small mb-1">Email Address</p>
                            <h6 class="fw-semibold mb-0 text-break">
                                <%= user.email || "Not available" %>
                            </h6>
                        </div>
                    </div>

                    <!-- Account ID -->
                    <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-light">
                        <div class="rounded-3 bg-white shadow-sm p-3 text-primary">
                            <i class="fa-solid fa-fingerprint fa-lg"></i>
                        </div>

                        <div class="flex-grow-1">
                            <p class="text-secondary small mb-1">Account ID</p>
                            <h6 class="fw-semibold mb-0 text-break">
                                <%= user._id %>
                            </h6>
                        </div>
                    </div>

                    <div class="alert alert-primary border-0 rounded-3 mt-4 mb-0">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        Keep your account credentials private to protect your account.
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>
