
<%- layout("boilerplate/boiler") %>

<style>
    .contact-page {
        min-height: 100vh;
        background: #f8fafc;
        padding: 55px 0;
    }

    .contact-hero {
        max-width: 750px;
        margin: 0 auto 40px;
        text-align: center;
    }

    .contact-icon {
        width: 65px;
        height: 65px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 18px;
        background: #e8f0ff;
        color: #2563eb;
        font-size: 27px;
        margin-bottom: 20px;
    }

    .contact-hero h1 {
        color: #172554;
        font-weight: 800;
        font-size: clamp(2rem, 5vw, 3rem);
    }

    .contact-hero p {
        color: #64748b;
        line-height: 1.8;
    }

    .contact-card {
        height: 100%;
        padding: 25px;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #fff;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .contact-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(15, 23, 42, .07);
    }

    .member-avatar {
        width: 55px;
        height: 55px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 15px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 18px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .member-name {
        color: #1e293b;
        font-weight: 750;
        font-size: 1.2rem;
    }

    .member-role {
        color: #64748b;
        font-size: .9rem;
        margin-bottom: 20px;
    }

    .contact-detail {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-top: 16px;
        min-width: 0;
    }

    .detail-icon {
        color: #2563eb;
        width: 18px;
        margin-top: 3px;
        flex-shrink: 0;
    }

    .detail-label {
        display: block;
        color: #94a3b8;
        font-size: .78rem;
        margin-bottom: 3px;
    }

    .detail-value {
        color: #334155;
        font-size: .91rem;
        overflow-wrap: anywhere;
    }

    .detail-value a {
        color: #334155;
        text-decoration: none;
    }

    .detail-value a:hover {
        color: #2563eb;
        text-decoration: underline;
    }

    .contact-footer {
        margin-top: 35px;
        padding: 30px 20px;
        text-align: center;
        background: #172554;
        color: white;
        border-radius: 20px;
    }

    .contact-footer p {
        color: #cbd5e1;
        margin-bottom: 0;
    }

    @media (max-width: 576px) {
        .contact-page {
            padding: 35px 0;
        }

        .contact-card {
            padding: 21px;
        }
    }
</style>

